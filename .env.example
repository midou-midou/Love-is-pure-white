# 空模板：真实值只在运行环境注入，不得写入仓库。
# 本地用法：cp .env.example .env  →  填入真实值  →  uv run --env-file .env <命令>
# .env 已被 .gitignore 忽略；本模板必须保持为空，防止密钥进入版本控制。

# --- 密钥（保持为空，禁止提交真实值）---
DEEPSEEK_API_KEY=
QQ_APP_ID=
QQ_APP_SECRET=

# --- 非敏感运行配置（版本化，修改产生新版本）---
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# EMBEDDING_KIND=local            → 本地 HuggingFace 模型，EMBEDDING_REVISION 必须是精确 commit
# EMBEDDING_KIND=openai_compatible → OpenAI 兼容的向量 API，需要 EMBEDDING_API_KEY 与 EMBEDDING_BASE_URL
EMBEDDING_KIND=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_REVISION=
# 远程向量（例如硅基流动）：用 EMBEDDING_API_KEY，SILICONFLOW_API_KEY 作为兼容别名
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# 维度与输入上限必须与所选模型一致，缺失或与响应不符时明确失败（不做静默降级）
EMBEDDING_DIMENSION=
EMBEDDING_MAX_TOKENS=
RUNTIME_DIR=runtime

# --- 云链路追踪：默认关闭 ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# --- Docker Compose 部署专用（本地 uv 运行时忽略）---
# 镜像名：直接构建用默认，从 ACR 拉取时填 registry.cn-hangzhou.aliyuncs.com/<ns>/sana-bot:<tag>
# SANABOT_IMAGE=sana-bot:latest
# 宿主侧发布端口（只绑定 127.0.0.1）
# SANABOT_PORT=8000
# 宿主侧运行目录；容器内始终是 /app/runtime。属主必须可写（见 doc/部署_Aliyun_Docker.md §3）
# SANABOT_RUNTIME_DIR=./runtime
# 本地向量后端是可选依赖；默认镜像不装 torch，需要时置 1 并重建镜像
# INSTALL_LOCAL_EMBEDDINGS=0
# 构建期 PyPI 镜像（阿里云内网提速）
# UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple
# 启用 --profile tls（Caddy 自动 HTTPS）时才需要
# SANABOT_DOMAIN=bot.example.com
# ACME_EMAIL=you@example.com
# TZ=Asia/Shanghai
